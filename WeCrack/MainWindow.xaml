<Window x:Class="WeCrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WeCrack :: WeMod / Wand entitlement bypass"
        Icon="resources/icon.ico"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="960"
        Background="{StaticResource Brush.Bg.Root}"
        Foreground="{StaticResource Brush.Fg.Text}"
        FontFamily="{StaticResource Font.Mono}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Root border = our custom window edge. Phosphor green so it reads as a terminal window. -->
    <Border x:Name="RootBorder"
            BorderBrush="{StaticResource Brush.Border.Accent}"
            BorderThickness="1"
            Background="{StaticResource Brush.Bg.Root}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- Custom title bar   -->
                <RowDefinition Height="*"/>    <!-- Main content       -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR (custom) ═════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Bg.CardHeader}"
                    BorderBrush="{StaticResource Brush.Border.Dim}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- left: logo + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Fg.Green}" Text="&gt;_"/>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                   Foreground="{StaticResource Brush.Fg.Text}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="WeCrack :: WeMod / Wand entitlement bypass"/>
                    </StackPanel>

                    <!-- right: window controls (must be hit-test visible to receive clicks) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}"
                                x:Name="BtnMinimize"
                                Click="OnMinimize"
                                ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}"
                                x:Name="BtnMaximize"
                                Click="OnMaximizeRestore"
                                ToolTip="Maximize">
                            <Path x:Name="MaxIcon"
                                  Data="M0,0 L10,0 10,10 0,10 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton.Close}"
                                x:Name="BtnClose"
                                Click="OnClose"
                                ToolTip="Close">
                            <Path Data="M0,0 L10,10 M0,10 L10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header banner   -->
                    <RowDefinition Height="Auto"/>   <!-- Action strip    -->
                    <RowDefinition Height="*"/>      <!-- Body            -->
                    <RowDefinition Height="Auto"/>   <!-- Status footer   -->
                </Grid.RowDefinitions>

                <!-- ─── HEADER BANNER ─────────────────────────────────────── -->
                <Border Grid.Row="0"
                        Background="{StaticResource Brush.Bg.Card}"
                        BorderBrush="{StaticResource Brush.Border.Accent}"
                        BorderThickness="1"
                        Padding="18,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Fg.Green}">
                                <Run Text="&gt;_"/> <Run Text=" WeCrack"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0"
                                       Text="WeMod / Wand entitlement bypass · dynamic patcher · ASAR fuse bypass"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.Fg.Dim}"
                                   Text="v1.0"/>
                    </Grid>
                </Border>

                <!-- ─── ACTIONS ────────────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource CardHeaderText}" Text="[ ACTIONS ]"/>
                        </Border>
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnInstall"
                                    Style="{StaticResource TerminalButton}"
                                    Content="[ 1 ]  INSTALL"
                                    Click="OnInstall"
                                    Margin="0,0,10,0"
                                    MinWidth="170"/>
                            <Button Grid.Column="1" x:Name="BtnUninstall"
                                    Style="{StaticResource TerminalButton.Danger}"
                                    Content="[ 2 ]  UNINSTALL"
                                    Click="OnUninstall"
                                    Margin="0,0,10,0"
                                    MinWidth="170"/>
                            <Button Grid.Column="2" x:Name="BtnVerify"
                                    Style="{StaticResource TerminalButton}"
                                    Content="[ 3 ]  VERIFY"
                                    Click="OnVerify"
                                    Margin="0,0,10,0"
                                    MinWidth="170"/>
                            <TextBlock Grid.Column="4"
                                       x:Name="BusySpinner"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Fg.Amber}"
                                       Visibility="Collapsed"
                                       Text=" WORKING…"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── BODY: two columns ─────────────────────────────────── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: state cards -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="[ INSTALL DISCOVERY ]"/>
                                    </Border>
                                    <Grid Margin="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="root"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblRoot" Text="—"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="version" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblVersion" Text="—" Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.Fg.Cyan}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="[ FILES ]"/>
                                    </Border>
                                    <Grid Margin="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="name"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Label}" Text="state"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Label}" Text="size (bytes)" Margin="12,0,12,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="sha256 (first 16)"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Body}" Text="Wand.exe"          Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblWandState"    Margin="0,4,0,0" Text="—"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Body}" x:Name="LblWandSize"     Margin="12,4,12,0" Text="—" TextAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Body}" x:Name="LblWandSha"      Margin="0,4,0,0" Text="—"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Body}" Text="app.asar"          Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblAsarState"    Margin="0,4,0,0" Text="—"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Body}" x:Name="LblAsarSize"     Margin="12,4,12,0" Text="—" TextAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Body}" x:Name="LblAsarSha"      Margin="0,4,0,0" Text="—"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Body}" Text="Wand.exe.orig"     Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblWandBkState"  Margin="0,4,0,0" Text="—"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Body}" x:Name="LblWandBkSize"   Margin="12,4,12,0" Text="—" TextAlignment="Right"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Body}" x:Name="LblWandBkSha"    Margin="0,4,0,0" Text="—"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Body}" Text="app.asar.orig"     Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Body}" x:Name="LblAsarBkState"  Margin="0,4,0,0" Text="—"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Body}" x:Name="LblAsarBkSize"   Margin="12,4,12,0" Text="—" TextAlignment="Right"/>
                                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Body}" x:Name="LblAsarBkSha"    Margin="0,4,0,0" Text="—"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="[ ELECTRON FUSE ]"/>
                                    </Border>
                                    <Grid Margin="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="fuse"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}"  Text="EmbeddedAsarIntegrityValidation"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="offset" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}"  x:Name="LblFuseOffset" Text="—" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="state" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LblFuseState" Text="—" Margin="0,4,0,0"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Fg.Amber}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="[ STATUS ]"/>
                                    </Border>
                                    <StackPanel Margin="12">
                                        <TextBlock x:Name="LblStatus"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Text="—"
                                                   Foreground="{StaticResource Brush.Fg.Dim}"/>
                                        <TextBlock x:Name="LblStatusHint"
                                                   Style="{StaticResource Label}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Press [ 3 ] VERIFY to inspect the current install."/>
                                        <Button x:Name="BtnBrowse"
                                                Style="{StaticResource TerminalButton}"
                                                Content="[ Browse for WeMod folder... ]"
                                                Click="OnBrowseInstall"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Padding="14,7"
                                                FontSize="12"
                                                Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: log console — plain ScrollViewer + StackPanel of TextBlocks -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="[ LOG ]"/>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="10">
                                        <Hyperlink x:Name="LnkClear" Click="OnClearLog"
                                                   Foreground="{StaticResource Brush.Fg.Dim}"
                                                   TextDecorations="Underline">
                                            clear
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="LogScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="{StaticResource Brush.Bg.Log}"
                                          Padding="12,10">
                                <StackPanel x:Name="LogPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── FOOTER ─────────────────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="{StaticResource Brush.Bg.CardHeader}"
                        BorderBrush="{StaticResource Brush.Border.Dim}"
                        BorderThickness="1"
                        Padding="12,6"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="ready. no writes without your click. backups are always taken first."/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" x:Name="LblTime" Text=""/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
