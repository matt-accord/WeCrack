<Application x:Class="WeCrack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ─── palette ────────────────────────────────────────────────────── -->
        <Color x:Key="Bg.Root">#FF0A0E14</Color>
        <Color x:Key="Bg.Card">#FF0F1520</Color>
        <Color x:Key="Bg.CardHeader">#FF141C2C</Color>
        <Color x:Key="Bg.Log">#FF06090F</Color>
        <Color x:Key="Bg.Hover">#FF16223A</Color>
        <Color x:Key="Bg.Press">#FF1F3255</Color>
        <Color x:Key="Border.Dim">#FF1F2937</Color>
        <Color x:Key="Border.Accent">#FF00FF9C</Color>
        <Color x:Key="Fg.Text">#FFD6DEEB</Color>
        <Color x:Key="Fg.Dim">#FF6B7280</Color>
        <Color x:Key="Fg.Green">#FF00FF9C</Color>
        <Color x:Key="Fg.Amber">#FFFFB86C</Color>
        <Color x:Key="Fg.Red">#FFFF5370</Color>
        <Color x:Key="Fg.Cyan">#FF80E1FF</Color>
        <Color x:Key="Scroll.Thumb">#FF2A3446</Color>
        <Color x:Key="Scroll.ThumbHover">#FF3B4A66</Color>

        <SolidColorBrush x:Key="Brush.Bg.Root"       Color="{StaticResource Bg.Root}"/>
        <SolidColorBrush x:Key="Brush.Bg.Card"       Color="{StaticResource Bg.Card}"/>
        <SolidColorBrush x:Key="Brush.Bg.CardHeader" Color="{StaticResource Bg.CardHeader}"/>
        <SolidColorBrush x:Key="Brush.Bg.Log"        Color="{StaticResource Bg.Log}"/>
        <SolidColorBrush x:Key="Brush.Bg.Hover"      Color="{StaticResource Bg.Hover}"/>
        <SolidColorBrush x:Key="Brush.Bg.Press"      Color="{StaticResource Bg.Press}"/>
        <SolidColorBrush x:Key="Brush.Border.Dim"    Color="{StaticResource Border.Dim}"/>
        <SolidColorBrush x:Key="Brush.Border.Accent" Color="{StaticResource Border.Accent}"/>
        <SolidColorBrush x:Key="Brush.Fg.Text"       Color="{StaticResource Fg.Text}"/>
        <SolidColorBrush x:Key="Brush.Fg.Dim"        Color="{StaticResource Fg.Dim}"/>
        <SolidColorBrush x:Key="Brush.Fg.Green"      Color="{StaticResource Fg.Green}"/>
        <SolidColorBrush x:Key="Brush.Fg.Amber"      Color="{StaticResource Fg.Amber}"/>
        <SolidColorBrush x:Key="Brush.Fg.Red"        Color="{StaticResource Fg.Red}"/>
        <SolidColorBrush x:Key="Brush.Fg.Cyan"       Color="{StaticResource Fg.Cyan}"/>
        <SolidColorBrush x:Key="Brush.Scroll.Thumb"      Color="{StaticResource Scroll.Thumb}"/>
        <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="{StaticResource Scroll.ThumbHover}"/>

        <!-- ─── typography ─────────────────────────────────────────────────── -->
        <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New, Lucida Console</FontFamily>

        <!-- ─── card container ────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"          Value="{StaticResource Brush.Bg.Card}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource Brush.Border.Dim}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin"              Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardHeader" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Brush.Bg.CardHeader}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Border.Dim}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,6"/>
        </Style>

        <Style x:Key="CardHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Fg.Green}"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Brush.Fg.Text}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Fg.Dim}"/>
        </Style>

        <!-- ─── terminal action button ────────────────────────────────────── -->
        <Style x:Key="TerminalButton" TargetType="Button">
            <Setter Property="FontFamily"      Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Fg.Green}"/>
            <Setter Property="Background"      Value="{StaticResource Brush.Bg.Card}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Border.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Press}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Fg.Dim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Dim}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalButton.Danger" TargetType="Button" BasedOn="{StaticResource TerminalButton}">
            <Setter Property="Foreground"  Value="{StaticResource Brush.Fg.Amber}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Fg.Amber}"/>
        </Style>

        <!-- ─── window control buttons (min / max / close) ────────────────── -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Fg.Dim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontFamily"      Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Fg.Green}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Press}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button — red hover to make destructive intent obvious. -->
        <Style x:Key="ChromeButton.Close" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Fg.Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFAA3040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── scroll bar (implicit style — applies everywhere) ──────────── -->
        <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="IsTabStop"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="{StaticResource Brush.Scroll.Thumb}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="0"
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Scroll.ThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Border.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Log}"/>
            <Setter Property="Width"      Value="12"/>
            <Setter Property="MinWidth"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBar.PageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBar.PageButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBar.Thumb}" MinHeight="30"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollBar.PageButton}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollBar.PageButton}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBar.Thumb}" MinWidth="30"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
